# cafe 컨테이너(prod 프로파일)가 받는 환경 변수 목록 — 값은 넣지 않음
#
# .env 는 저장소에 올리지 않음. 실제 값은 클러스터에서 주입함
# (어디서 주입할지는 인프라 · 매니페스트 구성이 정해지면 연결)

SPRING_PROFILES_ACTIVE=prod

# 주문 DB (RDS MySQL)
DB_URL=jdbc:mysql://<rds_endpoint>:3306/cafe?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# 선택 · 표 자동 생성 (기본 update)
# DDL_AUTO=validate

# 선택 · 연결 풀 (비우면 HikariCP 기본 최대 10 · 대기 30초)
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
# SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=2
# SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=3000
