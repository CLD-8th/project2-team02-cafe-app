# cafe 앱(prod 프로파일)이 받는 환경 변수 목록 — 값은 넣지 않음
#
# .env 는 저장소에 올리지 않음. 값을 어디서 넣을지는 운영 환경이 정해지면 연결

SPRING_PROFILES_ACTIVE=prod

# 주문 DB (MySQL)
DB_URL=jdbc:mysql://<db_host>:3306/cafe?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# 로그인 토큰 서명 키 (32바이트 이상 · 앱이 여러 개면 모두 같은 값)
JWT_SECRET=

# 선택 · 기동 시 직원 계정 생성 (둘 다 있을 때만 · 이미 있으면 건너뜀)
STAFF_USERNAME=
STAFF_PASSWORD=

# 메뉴 사진 S3 버킷 (자격 증명은 Pod Identity · 키를 넣지 않음)
APP_S3_BUCKET=
AWS_REGION=ap-northeast-2

# 선택 · 표 자동 생성 (기본 update)
# DDL_AUTO=validate

# 선택 · DB 연결 풀 (비우면 HikariCP 기본 최대 10 · 대기 30초)
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
# SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=3000
